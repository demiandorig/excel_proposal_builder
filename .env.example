# Copy this to .env and fill in your values.
# The app runs without these — Drive upload returns a "not configured" stub.

# Google Drive integration — OAuth2 web client credentials
# Get these from console.cloud.google.com > APIs & Services > Credentials > OAuth 2.0 Client IDs
# IMPORTANT: rotate the client_secret if it was ever exposed outside this machine.
DRIVE_CLIENT_ID=your-client-id.apps.googleusercontent.com
DRIVE_CLIENT_SECRET=your-client-secret
DRIVE_ROOT_FOLDER_ID=your-drive-folder-id

# Notion integration — lets Step 01 search the Requests database instead of
# copy-pasting by hand. This is a PERSONAL ACCESS TOKEN (notion.so/my-integrations),
# not a durable workspace integration, so it's tied to whoever created it —
# it must also be manually connected to the Requests database itself
# (open the database in Notion > "···" menu > Connections > add the integration).
# IMPORTANT: rotate the token if it was ever exposed outside this machine.
NOTION_API_TOKEN=your-personal-access-token
NOTION_REQUESTS_DATABASE_ID=your-database-id

# Project Constanza — DMA/audience avails engine (app/services/constanza_*.py)
#
# Only needed to RE-RUN the offline data-extraction scripts (scripts/
# extract_constanza_*.py, scripts/aggregate_constanza_acs_dma_state.py) —
# the app itself just reads the bundled JSON under app/data/constanza/ and
# needs none of this at runtime. Free, instant signup:
# https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=your-census-api-key

# Meta auction audience estimates for Project Constanza. The ad account ID
# may be entered with or without act_. Store the token only in Replit Secrets.
# The app's manual-audience planning model works without these values.
META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v26.0

# Google Ads API — powers constanza_search.py's search-interest grounding
# for the audience layer (app/services/constanza_audience.py). NOT
# required to run the app — without these, the search-interest multiplier
# always fails open to a no-op 1.0, same degrade pattern as everything
# else here. Needs a Google Ads manager (MCC) account + developer token;
# see constanza_search.py's module docstring for the geo-target crosswalk
# that still needs building before this can actually activate.
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token
GOOGLE_ADS_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_ADS_REFRESH_TOKEN=your-refresh-token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=your-mcc-customer-id

# Roadblocks reads a stored copy of the "Restricted Verticals by Platforms" Google Sheet. A copy an admin already synced
# is re-read from Google when it is older than this many minutes (needs the Google Drive connection; 0 = never).
RESTRICTIONS_AUTO_SYNC_MINUTES=60

# Gamma — the Step 08 "Create in Gamma" button sends the outline to Gamma's API, which builds the deck in the
# key owner's Gamma workspace; the planner then finishes it in Gamma. Needs a Gamma plan with API access
# (Pro, Ultra, Teams or Business); every deck spends Gamma credits. Without a key the button just copies the
# outline for pasting into Gamma. Put the key in Replit Secrets / your local .env — never in code or chat.
GAMMA_API_KEY=
# Optional: a brand theme id, a folder id, and what the rest of the workspace may do with new decks
# (edit | comment | view | noAccess | fullAccess; default edit).
GAMMA_THEME_ID=
GAMMA_FOLDER_ID=
GAMMA_WORKSPACE_ACCESS=edit
